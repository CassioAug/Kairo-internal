    <string name="starting_tutorial_progress">%1$d of %2$d</string>
    <string name="starting_tutorial_intro_title">Welcome to Kairo</string>
    <string name="starting_tutorial_intro_body">Kairo starts in your library. Import a book, open it, then tap the focus word in Reader to jump into RSVP playback.</string>
    <string name="starting_tutorial_import_title">Import your first book</string>
    <string name="starting_tutorial_import_body">Use this button to bring in DRM-free EPUB or MOBI files from device storage.</string>
    <string name="starting_tutorial_tabs_title">Switch between library and bookmarks</string>
    <string name="starting_tutorial_tabs_body">The second tab collects saved bookmarks so you can jump back into important passages fast.</string>
    <string name="starting_tutorial_library_settings_title">Open app settings</string>
    <string name="starting_tutorial_library_settings_body">Settings gives you access to RSVP tuning, reader appearance, focus mode, language, and this tutorial.</string>
    <string name="starting_tutorial_language_title">Change the app language</string>
    <string name="starting_tutorial_language_body">If you want a different app language, start here. It only affects the interface, not your imported books.</string>
    <string name="starting_tutorial_rsvp_title">Tune RSVP playback</string>
    <string name="starting_tutorial_rsvp_body">Adjust speed, timing, readability heuristics, typography, and saved RSVP profiles in this section.</string>
    <string name="starting_tutorial_reader_title">Customize the reader</string>
    <string name="starting_tutorial_reader_body">Control font size, reader theme, text brightness, and scrolling behavior for the standard reading view.</string>
    <string name="starting_tutorial_focus_title">Use focus mode</string>
    <string name="starting_tutorial_focus_body">Focus mode can hide system chrome and optionally pause notifications while you read or use RSVP.</string>
    <string name="starting_tutorial_replay_title">Replay this walkthrough anytime</string>
    <string name="starting_tutorial_replay_body">Come back to this row whenever you want the guided tour again. Skipping or finishing it also prevents it from auto-opening next launch.</string>
    <string name="starting_tutorial_reader_navigation_title">Move through the reader</string>
    <string name="starting_tutorial_reader_navigation_body">Use the previous and next buttons here to change pages or chapters. You can also swipe left and right anywhere in the reader to move backward and forward.</string>
    <string name="starting_tutorial_reader_launch_title">Jump from Reader into RSVP</string>
    <string name="starting_tutorial_reader_launch_body">Tap the highlighted focus word in the text, or use this play dock, to launch RSVP from your current reading position.</string>
    <string name="starting_tutorial_reader_menu_title">Open Reader tools</string>
    <string name="starting_tutorial_reader_menu_body">This menu opens quick Reader actions like bookmarks, table of contents, focus mode, and Reader-specific settings.</string>
    <string name="starting_tutorial_reader_menu_settings_title">Adjust Reader view settings</string>
    <string name="starting_tutorial_reader_menu_settings_body">Inside the Reader menu, this section lets you tune font size, theme, text brightness, and scrolling behavior without leaving the book.</string>
    <string name="starting_tutorial_rsvp_playback_title">Pause and step through RSVP</string>
    <string name="starting_tutorial_rsvp_playback_body">Tap the RSVP screen to pause or resume. When playback controls are open, use the center button for play or pause and the side buttons to move backward or forward frame by frame.</string>
    <string name="starting_tutorial_rsvp_topbar_title">Open RSVP tools</string>
    <string name="starting_tutorial_rsvp_topbar_body">When RSVP is paused, this settings button opens quick controls for theme, focus mode, tempo, text size, and the full RSVP tuning panel.</string>
    <string name="starting_tutorial_rsvp_gestures_title">Use RSVP gestures</string>
    <string name="starting_tutorial_rsvp_gestures_body">Use gestures directly in the RSVP view. Swipe up or down to change WPM, and swipe left or right to sweep backward or forward through the session.</string>
    <string name="starting_tutorial_rsvp_exit_title">Exit RSVP mode</string>
    <string name="starting_tutorial_rsvp_exit_body">To leave RSVP, long hold the screen or tap the X in the top-right corner. A long hold should feel like a brief press-and-release, not a drag.</string>
    <string name="starting_tutorial_rsvp_settings_title">Open advanced RSVP settings</string>
    <string name="starting_tutorial_rsvp_settings_body">This opens the deeper RSVP settings screen where you can fine-tune timing, typography, profiles, and readability behavior for the playback engine.</string>
